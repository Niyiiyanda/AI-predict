# GEMINI_API_KEY: Required for Gemini AI Match Analyst API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# API_FOOTBALL_KEY: Required key for API-Football v3 (https://www.api-football.com/ or RapidAPI) for La Liga, Bundesliga, Serie A, Ligue 1.
API_FOOTBALL_KEY=""
RAPIDAPI_KEY=""

# THE_ODDS_API_KEY: Required key for The Odds API (https://the-odds-api.com/) for live odds & EV engine calculations.
THE_ODDS_API_KEY=""

# SOFASCORE_API_KEY: Key for Sofascore for live scores, momentum graphs & H2H stats.
SOFASCORE_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
